{
    "name": "ogunsakin01/laravel-video-demos",
    "description": "Automatic how-to and product demo videos for Laravel apps. Describe a flow; AI plans it from your code, a real browser records it, and it stays up to date when your UI changes. Help center, embeds, any screen size.",
    "keywords": [
        "laravel",
        "video",
        "how-to",
        "tutorial",
        "walkthrough",
        "product-demo",
        "product-tour",
        "screencast",
        "screen-recording",
        "help-center",
        "user-guide",
        "knowledge-base",
        "onboarding",
        "documentation",
        "ai",
        "llm",
        "claude",
        "anthropic",
        "openai",
        "gemini",
        "ollama",
        "playwright"
    ],
    "homepage": "https://github.com/ogunsakin01/laravel-video-demos/wiki",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Damilola Ogunsakin",
            "email": "ogunsakin191@gmail.com",
            "homepage": "https://github.com/ogunsakin01",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/ogunsakin01/laravel-video-demos/issues",
        "source": "https://github.com/ogunsakin01/laravel-video-demos",
        "security": "https://github.com/ogunsakin01/laravel-video-demos/security/advisories/new"
    },
    "require": {
        "php": "^8.3",
        "anthropic-ai/sdk": "^0.59",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/process": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/mcp": "^1.0",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "prism-php/prism": "^0.100.1"
    },
    "suggest": {
        "prism-php/prism": "To plan videos with OpenAI, Gemini, Mistral, DeepSeek, Groq, xAI, OpenRouter or local Ollama models (^0.100)",
        "laravel/mcp": "To let coding agents (Claude Code, Cursor) make, check and publish videos through the \"video-demos\" MCP server (^1.0)"
    },
    "autoload": {
        "psr-4": {
            "Ogunsakin01\\VideoDemo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ogunsakin01\\VideoDemo\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --port=8123 --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ogunsakin01\\VideoDemo\\VideoDemoServiceProvider"
            ],
            "aliases": {
                "VideoDemo": "Ogunsakin01\\VideoDemo\\Facades\\VideoDemo"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
