{
    "name": "ogunsakin01/laravel-video-demos",
    "description": "Generate how-to videos of your Laravel app with Claude. Describe a flow, set a length, see the cost, and get a recorded walkthrough.",
    "keywords": [
        "laravel",
        "video",
        "demo",
        "tutorial",
        "playwright",
        "claude",
        "anthropic"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Damilola Ogunsakin",
            "email": "ogunsakin191@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "anthropic-ai/sdk": "^0.57",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/process": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ogunsakin01\\VideoDemo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ogunsakin01\\VideoDemo\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --port=8123 --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ogunsakin01\\VideoDemo\\VideoDemoServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
